{
  "name": "textbook",
  "version": "1.3.0",
  "private": true,
  "description": "Self-hosted full-subject textbook reader with PDF annotation, rich notes and AI study analysis",
  "license": "MIT",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite server/index.js",
    "dev": "node --experimental-sqlite server/index.js",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "sync:workbench": "node scripts/sync-workbench.mjs",
    "pack:all": "node scripts/build-packages.mjs",
    "pack:upgrade": "node scripts/build-upgrade-package.mjs",
    "check:upgrade": "node scripts/check-upgrade.mjs",
    "check:upgrade:ui": "node scripts/check-upgrade-ui.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:ssl": "node scripts/check-ssl.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
